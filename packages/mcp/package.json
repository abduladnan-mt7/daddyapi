{
  "name": "@daddyapi/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Serve a daddyapi SiteSpec as an MCP server: each resource becomes a typed, read-only tool for AI agents.",
  "license": "MIT",
  "author": "Abdul Adnan",
  "homepage": "https://github.com/abduladnan-mt7/daddyapi#readme",
  "bugs": "https://github.com/abduladnan-mt7/daddyapi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abduladnan-mt7/daddyapi.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "daddyapi",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "scraping",
    "claude"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daddyapi/core": "workspace:*",
    "@daddyapi/spec": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  }
}
